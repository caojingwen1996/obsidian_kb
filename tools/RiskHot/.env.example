# Only local development defaults. Production must supply its own values.
NODE_ENV=development
DATABASE_URL=postgres://riskhot:riskhot-local@127.0.0.1:55432/riskhot
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=riskhot-development
API_HOST=127.0.0.1
API_PORT=4310
WEB_ORIGIN=http://127.0.0.1:4311
ARTIFACT_DIR=.data/artifacts
# First local visit creates the administrator; no default password is shipped.
# ALLOW_INITIAL_SETUP=true (temporary production bootstrap via loopback only)
# MODEL_PROVIDER=openai or anthropic; manual mode is the default.
MODEL_PROVIDER=manual
# MODEL_ID=
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.openai.com
