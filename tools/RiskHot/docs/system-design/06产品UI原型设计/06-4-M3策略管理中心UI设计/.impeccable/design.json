  "components": [
    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "原型基础主操作，包含hover、active、focus-visible及真实disabled层叠。",
      "html": "<button class=\"ds-button-primary\" type=\"button\">保存修订</button> <button class=\"ds-button-primary\" type=\"button\" disabled>保存修订</button>",
      "css": ".ds-button-primary{font-family:var(--font-ui, \"PingFang SC\", \"Microsoft YaHei\", sans-serif);font-size:14px;font-weight:500;line-height:1.5;min-height:40px;padding:9px 16px;border:1px solid var(--green,#295c47);border-radius:var(--radius-control,8px);background:var(--green,#295c47);color:#fff;cursor:pointer;transition:background-color var(--motion,150ms ease-out),border-color var(--motion,150ms ease-out),color var(--motion,150ms ease-out)}.ds-button-primary:hover:not(:disabled),.ds-button-primary:active:not(:disabled){background:var(--green-hover,#214c3b);border-color:var(--green-hover,#214c3b)}.ds-button-primary:focus-visible{outline:2px solid var(--green,#295c47);outline-offset:3px;}.ds-button-primary:disabled{opacity:.65;cursor:not-allowed;background:#f0f2ed;border-color:#e1e5df;color:#6c756f}@media(max-width:650px){.ds-button-primary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "AI职责标签",
      "kind": "chip",
      "refersTo": "ai-role",
      "description": "流程节点内非交互职责标签；使用可读的AI深紫文字。",
      "html": "<span class=\"ds-ai-role\">AI</span>",
      "css": ".ds-ai-role{display:inline-block;font-family:var(--font-ui, \"PingFang SC\", \"Microsoft YaHei\", sans-serif);padding:2px 6px;border:1px solid #cbbbdf;border-radius:5px;background:#f8f5ff;color:var(--ai-ink,#624392);font-size:11px;font-weight:500;line-height:1.6;white-space:nowrap}"
    },
    {
      "name": "输入框",
      "kind": "input",
      "refersTo": "input",
      "description": "字段正常、hover、focus-visible、disabled与移动端16px输入字号。",
      "html": "<label class=\"ds-field\">策略名称<input class=\"ds-input\" type=\"text\" placeholder=\"输入策略名称\"></label><label class=\"ds-field\">禁用字段<input class=\"ds-input\" type=\"text\" value=\"暂不可编辑\" disabled></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:7px;font-family:var(--font-ui, \"PingFang SC\", \"Microsoft YaHei\", sans-serif);font-size:14px;font-weight:500;line-height:1.65;color:var(--ink,#22352e);max-width:300px}.ds-input{font-family:var(--font-ui, \"PingFang SC\", \"Microsoft YaHei\", sans-serif);width:100%;min-width:0;min-height:40px;padding:9px 12px;border:1px solid #bdc9bf;border-radius:var(--radius-control,8px);background:var(--paper,#fff);color:var(--ink,#22352e);font-size:14px;font-weight:400;line-height:1.5;caret-color:var(--green,#295c47)}.ds-input::placeholder{color:#68736b}.ds-input:hover:not(:disabled){border-color:#879e8d}.ds-input:focus-visible{outline:2px solid var(--green,#295c47);outline-offset:3px;}.ds-input:disabled{background:#f3f5f1;color:#606c63;border-color:var(--line,#dfe5df)}@media(max-width:650px){.ds-input{font-size:16px}}"
    }
