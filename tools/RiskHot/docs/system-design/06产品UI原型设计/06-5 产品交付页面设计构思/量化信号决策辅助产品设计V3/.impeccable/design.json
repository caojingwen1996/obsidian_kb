  "narrative": {
    "northStar": "深蓝信号观察台",
    "overview": "以深蓝底色、克制边框与横向对齐的数字形成专业监测界面。对象列表先交付可比较的压力与判断理由，演化记录说明评估如何改变，来源链接支持继续追溯。\n\nV3 是已批准 V2 视觉体系的普通扩展，保留“深蓝信号观察台”的色彩、中文功能字体、密度和无投影层级。父目录一般阅读者版的浅色体系不是这里的视觉基准。所有分值、事件、日期与证据文字均为合成演示。",
    "keyCharacteristics": [
      "深蓝色阶区分背景、容器和选中状态。",
      "等宽数字与邻近单位支持横向比较。",
      "文字说明程度、方向、纳管状态与记录类型，颜色辅助阅读。",
      "宽屏列表与解读联动，窄屏堆叠；演化记录以日期组织。"
    ],
    "rules": [
      {
        "name": "The Semantic Direction Rule",
        "body": "方向必须由文字说明；绿色不等于安全，缺失和首次不伪装成持平。",
        "section": "colors"
      },
      {
        "name": "The Comparable Numbers Rule",
        "body": "数字使用 tabular-nums，并保留单位、截止时间与比较基准。",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "使用底色层级和细边框建立层次，不增加投影装饰。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用继承的深蓝色阶，以浅蓝区分链接、焦点与评估记录。",
      "Do 同时呈现方向文字、数值和颜色，保留单位、缺口与截止时间。",
      "Do 保留清晰的键盘焦点，为新增操作沿用 44px 最小交互高度。",
      "Do 将来源筛选与打开来源解读分成可辨认的相邻操作。"
    ],
    "donts": [
      "Don't 将父阅读版的浅色系统和圆角作为本产品校验标准。",
      "Don't 把缓解显示成安全、把未评分补零或把纳管状态当成压力程度。",
      "Don't 为已确认的两入口产品加入配置、订阅或资产录入入口。",
      "Don't 将当前快照与历史快照的内容混合在同一阅读上下文。"
    ]
  }
}
