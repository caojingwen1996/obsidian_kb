{
  "name": "riskhot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --import tsx tooling/dev.ts",
    "dev:api": "node --watch --import tsx apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:worker": "node --import tsx apps/worker/src/main.ts",
    "db:migrate": "node --import tsx tooling/migrate.ts",
    "db:seed": "node --import tsx tooling/seed.ts",
    "generate": "node --import tsx tooling/generate.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm generate && pnpm typecheck && vite build --config apps/web/vite.config.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/scenarios/*.test.ts",
    "test:e2e": "playwright test",
    "verify:boundaries": "node --import tsx tooling/boundaries.ts",
    "verify:all": "pnpm generate && pnpm typecheck && pnpm verify:boundaries && pnpm test && pnpm build",
    "report:scenarios": "node --import tsx tooling/scenario-report.ts",
    "start": "node --import tsx apps/api/src/main.ts",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "dev:temporal": "node --import tsx tooling/temporal-dev.ts",
    "dev:relay": "node --import tsx apps/outbox-relay/src/main.ts",
    "test:temporal": "node --import tsx apps/worker/test/smoke.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "18.0.7",
    "fastify": "5.12.5",
    "lucide-react": "1.55.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@temporalio/testing": "1.24.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
