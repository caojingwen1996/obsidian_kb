  "cards": [
    {
      "dot": "amber",
      "title": "P1｜证据与反证",
      "items": [
        "浮息占比高、再融资较多、利润缓冲薄的非金融企业。",
        "监测：重定价债务占比、执行利率、利息费用与利息保障倍数。",
        "固定利率存量债不立即跟随；有效对冲或经营增长可缓和。到期现金不足时另查 P4。"
      ]
    },
    {
      "dot": "amber",
      "title": "P2｜证据与反证",
      "items": [
        "依赖按揭、分期及客户资本开支的地产链、耐用品和设备企业。",
        "监测：客户融资全成本、贷款落实、实际采购及企业订单交付。",
        "其他客户增长可中断传导；名义降息仍需核对预期实际融资利率。"
      ]
    },
    {
      "dot": "amber",
      "title": "P7｜证据与反证",
      "items": [
        "重定价不匹配、存款成本黏性高、依赖净利息收入的银行。",
        "监测：分期限重定价缺口、资产收益率、负债成本率、净息差。",
        "非息收入、费用和信用减值可缓冲总利润；息差下降不等于流动性危机。"
      ]
    }
  ],
