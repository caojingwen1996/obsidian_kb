  "cards": [
    {
      "dot": "amber",
      "title": "P3｜证据与反证",
      "items": [
        "终值占比高、远期现金流占比高、依赖低利率假设的股票持有人。",
        "监测：相关期限收益率、要求回报率、盈利假设及现价隐含增长。",
        "须同步复核盈利与风险补偿；已充分重定价时不能机械继续加判风险。"
      ]
    },
    {
      "dot": "amber",
      "title": "P6｜证据与反证",
      "items": [
        "股价依赖宽松带动订单、投资和盈利迅速恢复的企业及持有人。",
        "监测：融资实际到账、扩张资金比例、资本开支完成率、销售收现。",
        "银行愿贷、企业愿借且满足条件才会传导；正常时滞不能直接判政策失效。"
      ]
    },
    {
      "dot": "amber",
      "title": "P9｜证据与反证",
      "items": [
        "依赖政策叙事、交易集中且忽略融资和估值差异的股票持有人。",
        "监测：事前预期差、观点同向占比、成交集中度与超额收益回吐。",
        "基本面重估、追保卖出分别核查；观点样本不等于全市场心理。"
      ]
    }
  ],
