  "cards": [
    {
      "dot": "amber",
      "title": "P4｜证据与反证",
      "items": [
        "短债集中、依赖滚动融资、受限现金多或缺稳定授信的企业。",
        "监测：可提款额度、到期支付、非受限现金及窗口资金缺口。",
        "已落实续作与到账现金可中断；仅报价变贵先按 P1 成本风险记录。"
      ]
    },
    {
      "dot": "amber",
      "title": "P5｜证据与反证",
      "items": [
        "利率敏感、对冲不匹配、期限错配且可用现金不足的账户。",
        "监测：净 DV01、抵押价值、追保通知、现金缺口及被动卖出成交。",
        "及时补资可中断；仅利率波动或价格下跌不能证明强平。"
      ]
    },
    {
      "dot": "amber",
      "title": "P8｜证据与反证",
      "items": [
        "外币债务集中、外币收入不足、依赖短期掉期或跨境融资的企业。",
        "监测：外币全成本、有效对冲、到期本息及逐币种窗口资金缺口。",
        "同币种回款、及时兑换或已落实融资可缓和；不只看合并人民币现金。"
      ]
    }
  ],
