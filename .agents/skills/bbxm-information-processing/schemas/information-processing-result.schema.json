{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "information-processing-result.schema.json",
  "title": "InformationProcessingResult",
  "description": "Structured output contract for stateless, bottom-up feed-mode information processing. All objects belong to the current run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "mode",
    "generated_at",
    "summary",
    "core_findings"
  ],
  "properties": {
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "const": "feed"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO-8601 generation timestamp."
    },
    "observation_window": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ]
        },
        "end": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count",
        "signal_count",
        "cluster_count",
        "theme_count",
        "isolated_signal_count",
        "insufficient_for_higher_level_synthesis_count"
      ],
      "properties": {
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "signal_count": {
          "type": "integer",
          "minimum": 0
        },
        "cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "theme_count": {
          "type": "integer",
          "minimum": 0
        },
        "isolated_signal_count": {
          "type": "integer",
          "minimum": 0
        },
        "insufficient_for_higher_level_synthesis_count": {
          "type": "integer",
          "minimum": 0
        },
        "key_signal_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "cluster_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "theme_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "isolated_signal_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "core_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "conclusion",
          "confidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "conclusion": {
            "type": "string",
            "minLength": 1,
            "description": "The most important information conclusion worth retaining from the current run."
          },
          "supporting_event_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "supporting_signal_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "supporting_cluster_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "theme_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "why_it_matters": {
            "type": [
              "string",
              "null"
            ]
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "supporting_event_refs"
            ]
          },
          {
            "required": [
              "supporting_signal_refs"
            ]
          },
          {
            "required": [
              "supporting_cluster_refs"
            ]
          },
          {
            "required": [
              "theme_ref"
            ],
            "properties": {
              "theme_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "isolated_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_ref",
          "reason"
        ],
        "properties": {
          "signal_ref": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "insufficient_for_higher_level_synthesis": {
      "type": "array",
      "description": "Current-run Signals or Clusters that are valid but do not support a higher-level Cluster or Theme synthesis.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_type",
          "ref_id",
          "reason"
        ],
        "properties": {
          "ref_type": {
            "type": "string",
            "enum": [
              "signal",
              "cluster"
            ]
          },
          "ref_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "event.schema.json"
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "signal.schema.json"
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "$ref": "cluster.schema.json"
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "$ref": "theme.schema.json"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
