{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "theme.schema.json",
  "title": "Theme",
  "description": "A higher-level question or explanatory structure synthesized from multiple Clusters in the current feed run. It has no cross-run lifecycle state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "theme_id",
    "theme_name",
    "core_question",
    "summary",
    "cluster_refs",
    "core_variables",
    "explanatory_compression",
    "confidence"
  ],
  "properties": {
    "theme_id": {
      "type": "string",
      "minLength": 1
    },
    "theme_name": {
      "type": "string",
      "minLength": 1
    },
    "core_question": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "cluster_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "core_variables": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "common_driver": {
      "type": [
        "string",
        "null"
      ]
    },
    "transmission_structure": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "directional_relationships": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "reinforce",
          "offset",
          "conflict",
          "reframe",
          "mixed"
        ]
      }
    },
    "explanatory_compression": {
      "type": "string",
      "minLength": 1,
      "description": "Why the higher-level Theme explains the supporting Clusters more clearly than keeping them separate."
    },
    "evidence_state": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "supporting_cluster_count": {
          "type": "integer",
          "minimum": 2
        },
        "source_diversity": {
          "type": [
            "string",
            "null"
          ]
        },
        "cross_market_confirmation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "directional_consistency": {
          "type": [
            "string",
            "null"
          ]
        },
        "contradictory_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inference_depth": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "medium",
            "high",
            null
          ]
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
