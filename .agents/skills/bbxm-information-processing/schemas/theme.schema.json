{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "theme.schema.json",
  "title": "Theme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "theme_id",
    "theme_name",
    "core_question",
    "summary",
    "cluster_refs",
    "core_variables",
    "current_direction",
    "status",
    "confidence"
  ],
  "properties": {
    "theme_id": {
      "type": "string",
      "minLength": 1
    },
    "theme_name": {
      "type": "string",
      "minLength": 1
    },
    "core_question": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "cluster_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "core_variables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "common_driver": {
      "type": [
        "string",
        "null"
      ]
    },
    "transmission_structure": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_direction": {
      "type": "string",
      "enum": [
        "strengthening",
        "weakening",
        "stable",
        "reversing",
        "mixed",
        "uncertain"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "emerging",
        "forming",
        "established",
        "weakening",
        "uncertain"
      ]
    },
    "evidence_state": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "supporting_cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_diversity": {
          "type": [
            "string",
            "null"
          ]
        },
        "cross_market_confirmation": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "time_persistence": {
          "type": [
            "string",
            "null"
          ]
        },
        "directional_consistency": {
          "type": [
            "string",
            "null"
          ]
        },
        "contradictory_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}