{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cluster.schema.json",
  "title": "Cluster",
  "description": "A coherent aggregation of at least two related Signals from the current feed run. It does not represent cross-run lifecycle state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cluster_id",
    "cluster_name",
    "summary",
    "member_signals",
    "relationships",
    "structure_view",
    "explanatory_compression",
    "strength",
    "confidence"
  ],
  "properties": {
    "cluster_id": {
      "type": "string",
      "minLength": 1
    },
    "cluster_name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "member_events": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "member_signals": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "same_problem",
          "same_variable",
          "same_direction",
          "same_driver",
          "same_subject",
          "same_time_window",
          "common_scope",
          "transmission_link",
          "evidence_diversity"
        ]
      }
    },
    "common_question": {
      "type": [
        "string",
        "null"
      ]
    },
    "common_variable": {
      "type": [
        "string",
        "null"
      ]
    },
    "common_driver": {
      "type": [
        "string",
        "null"
      ]
    },
    "common_direction": {
      "type": [
        "string",
        "null"
      ]
    },
    "directional_relationship": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "aligned",
        "mixed",
        "conflicting",
        "unknown",
        null
      ]
    },
    "structure_view": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "link_type",
          "supporting_refs"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "link_type": {
            "type": "string",
            "enum": [
              "observed",
              "inferred"
            ]
          },
          "supporting_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "explanatory_compression": {
      "type": "string",
      "minLength": 1,
      "description": "Why grouping these Signals produces a clearer explanation than listing them independently."
    },
    "time_range": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ]
        },
        "end": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time",
          "type",
          "ref_id",
          "summary"
        ],
        "properties": {
          "time": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "event",
              "signal"
            ]
          },
          "ref_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "variable": {
            "type": [
              "string",
              "null"
            ]
          },
          "direction": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "background",
              "pre_event",
              "key_event",
              "immediate_reaction",
              "repricing",
              "confirmation",
              "reversal",
              "follow_up",
              null
            ]
          }
        }
      }
    },
    "strength": {
      "type": "string",
      "enum": [
        "weak",
        "moderate",
        "strong"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
