{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InformationProcessingResult 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "generated_at",
    "context",
    "events",
    "timeline",
    "induction"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "observation_target",
        "time_window"
      ],
      "properties": {
        "mode": {
          "enum": [
            "feed",
            "monitor",
            "target"
          ]
        },
        "observation_target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name"
          ],
          "properties": {
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "time_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "core_question",
            "key_event_id",
            "start",
            "end",
            "pre_event_expectation",
            "post_event_repricing"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "core_question": {
              "type": [
                "string",
                "null"
              ]
            },
            "key_event_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "start": {
              "type": [
                "string",
                "null"
              ]
            },
            "end": {
              "type": [
                "string",
                "null"
              ]
            },
            "pre_event_expectation": {
              "type": [
                "string",
                "null"
              ]
            },
            "post_event_repricing": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "fact",
          "source",
          "structure"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "fact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time",
              "subject",
              "action",
              "object",
              "value",
              "unit"
            ],
            "properties": {
              "time": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subject": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "action": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "object": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value": {
                "type": [
                  "number",
                  "string",
                  "null"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "source_name",
              "source_type",
              "source_tier",
              "published_at",
              "raw_ref"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "source_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_tier": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "published_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "raw_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "structure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain",
              "hierarchy",
              "observation_objects",
              "financial_factors",
              "market_reactions"
            ],
            "properties": {
              "domain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hierarchy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "level",
                  "category"
                ],
                "properties": {
                  "level": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "category": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "observation_objects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "id",
                    "name"
                  ],
                  "properties": {
                    "type": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "financial_factors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "factor_id",
                    "factor_name",
                    "direction"
                  ],
                  "properties": {
                    "factor_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "factor_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "direction": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "market_reactions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "object_id",
                    "object_name",
                    "metric",
                    "direction",
                    "value",
                    "unit"
                  ],
                  "properties": {
                    "object_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "object_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "metric": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "direction": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "value": {
                      "type": [
                        "number",
                        "string",
                        "null"
                      ]
                    },
                    "unit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_ids"
      ],
      "properties": {
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 0
        }
      }
    },
    "induction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clusters"
      ],
      "properties": {
        "clusters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cluster_id",
              "core_question",
              "time_span",
              "event_ids",
              "common_phenomena",
              "core_variables",
              "induction_result"
            ],
            "properties": {
              "cluster_id": {
                "type": "string",
                "minLength": 1
              },
              "core_question": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "time_span": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "end": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "event_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 0
              },
              "common_phenomena": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "phenomenon_id",
                    "description",
                    "supporting_event_ids"
                  ],
                  "properties": {
                    "phenomenon_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "supporting_event_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "core_variables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "variable_id",
                    "variable_name",
                    "variable_type",
                    "supporting_event_ids",
                    "supporting_phenomenon_ids"
                  ],
                  "properties": {
                    "variable_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "variable_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "variable_type": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "supporting_event_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "supporting_phenomenon_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "induction_result": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "statement",
                  "supporting_event_ids",
                  "supporting_variable_ids"
                ],
                "properties": {
                  "statement": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "supporting_event_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "supporting_variable_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
